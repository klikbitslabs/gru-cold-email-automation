# --- Servidor ---
PORT=3000
# URL pública (HTTPS en producción). Se usa en el pixel de aperturas, enlaces de baja y el redirect de Google OAuth.
BASE_URL=http://localhost:3000
DATABASE_PATH=data/outreach.db

# --- Auth (JWT) ---
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Pon false después de crear tu cuenta para cerrar el registro.
ALLOW_REGISTRATION=true

# Clave de 32 bytes para cifrar los refresh tokens de Google (AES-256-GCM).
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Google Workspace (OAuth 2.0, Gmail API) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: solo estos dominios de Workspace pueden conectarse como sender (coma separada).
ALLOWED_GOOGLE_DOMAINS=
# Permitir cuentas @gmail.com personales (no recomendado para cold email).
ALLOW_CONSUMER_GMAIL=false

# --- Jev (TypeSafe System One) ---
# Sin clave, la herramienta usa reglas transparentes como respaldo.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# --- Secuencias / scheduler ---
MAX_SEQUENCE_STEPS=4
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
REPLY_CHECK_MINUTES=30
# Aperturas en los primeros N segundos tras enviar se marcan como bot/escáner.
OPEN_BOT_WINDOW_SECONDS=60
